<?xml version="1.0" encoding="utf-8"?>
<!-- Window state changes are requested for stock_home_redirect; with that key empty,
     onAccessibilityEvent returns at once. Key filtering depends only on
     flagRequestFilterKeyEvents and canRequestFilterKeyEvents, not on the event types. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/home_key_description" />
